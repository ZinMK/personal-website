{
  // Cloudflare Workers static-asset deploy for the Vite build output.
  // "single-page-application" makes react-router work on deep links / refresh.
  "name": "personal-website",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
